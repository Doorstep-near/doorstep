# Copy to .env and fill in. Never commit .env or .keys/.
NETWORK=mainnet

# Your named NEAR account (it pays for deploys and is the dispute owner).
OWNER=yourname.near
# The escrow contract account; must be a sub-account of OWNER.
ESCROW=escrow.yourname.near
# Backend account allowed to create orders. For Thursday's test, use OWNER.
RELAYER=yourname.near
# Public key of the delivery checker: node scripts/keys.mjs new --out .keys/checker.json
CHECKER_PK=ed25519:REPLACE_ME
# 10 minutes for the demo; 86400000 (24 h) for real use.
COMPLAINT_WINDOW_MS=600000

# For test orders (scripts/order.sh). Use your own account as SELLER so you can
# see the payout land in NEAR Intents.
SELLER=yourname.near
BUYER_REFUND=yourname.near

# 1Click auth: an API key (sent as X-API-Key) or a JWT (sent as Bearer).
ONECLICK_API_KEY=
ONECLICK_JWT=

# Optional: a different NEAR RPC endpoint for the Node scripts.
# NEAR_RPC=https://rpc.mainnet.fastnear.com

# ------------------------------------------------------------------ backend (services/api)
# Demo mode: fake chain, fake 1Click, mock courier, no network, in-memory DB.
# `npm run demo` sets it for you; leave it unset for the real thing.
# DEMO_MODE=true
# Complaint window used in demo mode (ms).
# DEMO_COMPLAINT_WINDOW_MS=120000

# HTTP port and bind address of the API.
API_PORT=8787
# API_HOST=localhost
# The web app's URL (CORS origin and pay links). No trailing slash.
WEB_URL=http://localhost:5173
# Other web app URLs allowed to call the API (comma-separated), e.g. a second host.
# CORS_ORIGINS=
# Seller dashboard password, sent as "Authorization: Bearer <token>". Pick a long random string.
# (Demo mode defaults it to "demo".)
SELLER_TOKEN=
# The shop: display name, the NEAR account that gets paid (defaults to SELLER),
# and the pickup address/phone used for Borzo bookings.
SHOP_NAME="My shop"
# SHOP_ACCOUNT=yourname.near
SHOP_ADDRESS=
SHOP_PHONE=
# Rupees per US dollar, for display-only estimates.
INR_PER_USD=84.2
# SQLite file (relative to the repo root). Demo mode uses memory instead.
DB_PATH=data/doorstep.sqlite

# Relayer: the account that sends create_order, mark_shipped, confirmations,
# release and refund. Defaults to RELAYER. Its function-call key (limited to the
# escrow) lives in RELAYER_KEY_FILE; make it with: bash scripts/add-relayer-key.sh
# RELAYER_ACCOUNT=yourname.near
RELAYER_KEY_FILE=.keys/relayer.json
# NEAR that key may spend on gas (used by scripts/add-relayer-key.sh).
# RELAYER_ALLOWANCE="1 NEAR"
# Delivery checker key (scripts/keys.mjs format); its public key must equal CHECKER_PK.
CHECKER_KEY_FILE=.keys/checker.json

# 1Click API base URL.
# ONECLICK_URL=https://1click.chaindefuser.com

# Borzo (India) courier. Test environment by default; production is
# https://robot-in.borzodelivery.com/api/business/1.8 (see https://borzodelivery.com/in/business-api/doc).
BORZO_BASE_URL=https://robotapitest-in.borzodelivery.com/api/business/1.8
# "X-DV-Auth-Token" from the Borzo personal cabinet.
BORZO_AUTH_TOKEN=
# "Callback Secret Key" from the Borzo personal cabinet; set the callback URL there to
# https://<your-api>/webhooks/borzo
BORZO_CALLBACK_SECRET=

# Ship24 (optional, for tracking numbers): API key to register trackers, and the
# webhook secret Ship24 sends as "Authorization: Bearer <secret>" to /webhooks/ship24.
SHIP24_API_KEY=
SHIP24_WEBHOOK_SECRET=

# How often the scheduler runs (ms): releases, refunds, chain sync, 1Click polling.
# SCHEDULER_INTERVAL_MS=60000
